generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  clerkId         String            @unique
  fullname        String
  image           String?
  coins           Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  activeProfileId String?
  activeProfile   Profile?          @relation("ActiveProfile", fields: [activeProfileId], references: [id], onDelete: SetNull)

  profiles              Profile[]
  posts                 Post[]
  comics                Comic[]
  purchases             CoinPurchase[]
  transactions          CoinTransaction[]
  comicUnlocks          ComicUnlock[]
  comments              Comment[]
  likes                 Like[]
  gameHistories         GameHistory[]
  commentLikes          CommentLike[]
  commentDislikes       CommentDislike[]
  commentReplies        CommentReply[] @relation("ReplyAuthor")
  notifications         Notification[] @relation("userNotifications")
  notificationsCreated  Notification[] @relation("notificationCreator")
}

model Post {
  id            String   @id @default(cuid())
  title         String
  date          String
  image         String
  imagePublicId String

  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, createdAt])
}

model HeroSection {
  id              String   @id @default(cuid())
  title           String
  backgroundImage String
  imagePublicId   String

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Notification {
  id         String            @id @default(cuid())
  userId     String
  creatorId  String
  type       NotificationType
  read       Boolean           @default(false)

  comicId    String?
  episodeId  String?
  commentId  String?
  replyId    String?

  createdAt  DateTime          @default(now())

  user       User              @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)
  creator    User              @relation("notificationCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comic      Comic?            @relation(fields: [comicId], references: [id], onDelete: Cascade)
  episode    Episode?          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  comment    Comment?          @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reply      CommentReply?     @relation(fields: [replyId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([commentId])
  @@index([replyId])
  @@index([episodeId])
}

enum NotificationType {
  COMIC
  COMMENT_LIKE
  COMMENT_DISLIKE
  COMMENT_REPLY
}

model Profile {
  id                 String            @id @default(cuid())
  name               String
  image              String
  cloudinaryPublicId String?
  userId             String
  user               User              @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  activeForUsers     User[]            @relation("ActiveProfile")
  myListComics       ComicMyList[]
  comicReactions     ComicReaction[]
}

model Comic {
  id                String             @id @default(cuid())
  title             String
  description       String
  thumbnail         String?
  thumbnailPublicId String?
  cloudinaryFolder  String?

  previewVideo      String?
  previewVideoPublicId String?

  userId            String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  episodes          Episode[]
  unlocks           ComicUnlock[]
  notifications     Notification[]
  myListedBy        ComicMyList[]
  reactions         ComicReaction[]
}

model ComicMyList {
  id        String   @id @default(cuid())
  profileId String
  comicId   String
  createdAt DateTime @default(now())

  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  comic     Comic    @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([profileId, comicId])
  @@index([profileId])
  @@index([comicId])
}

enum ComicReactionType {
  LIKE
  DISLIKE
}

model ComicReaction {
  id        String            @id @default(cuid())
  comicId   String
  profileId String
  type      ComicReactionType
  createdAt DateTime          @default(now())

  comic     Comic             @relation(fields: [comicId], references: [id], onDelete: Cascade)
  profile   Profile           @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([comicId, profileId, type])
  @@index([comicId])
  @@index([profileId])
}

model ComicUnlock {
  id         String   @id @default(cuid())
  userId     String
  comicId    String
  paidCoins  Int?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic      Comic    @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId])
  @@index([userId])
  @@index([comicId])
}

model Episode {
  id            String           @id @default(cuid())
  title         String
  description   String
  comicId       String
  order         Int
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  comments      Comment[]
  images        EpisodeImage[]
  comic         Comic            @relation(fields: [comicId], references: [id], onDelete: Cascade)
  like          Like[]
  notifications Notification[]

  @@index([comicId])
  @@unique([comicId, order])
}

model Like {
  id          String   @id @default(cuid())
  episodeId   String
  userId      String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId, episodeId])
  @@unique([userId, episodeId])
}

model Comment {
  id            String             @id @default(cuid())
  content       String
  authorId      String
  episodeId     String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  author        User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  episode       Episode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  likes         CommentLike[]
  dislikes      CommentDislike[]
  replies       CommentReply[]
  notifications Notification[]

  @@index([authorId, episodeId])
}

model CommentLike {
  id          String   @id @default(cuid())
  commentId   String
  userId      String
  createdAt   DateTime @default(now())

  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model CommentDislike {
  id          String   @id @default(cuid())
  commentId   String
  userId      String
  createdAt   DateTime @default(now())

  comment     Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@index([userId])
}

model CommentReply {
  id            String             @id @default(cuid())
  content       String
  commentId     String
  authorId      String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  comment       Comment            @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author        User               @relation("ReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([commentId])
  @@index([authorId])
}

model EpisodeImage {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String?
  order     Int
  createdAt DateTime @default(now())

  @@index([episodeId])
  @@index([publicId])
  @@unique([episodeId, order])
}

model CoinPlan {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  coins       Int
  bonusCoins  Int               @default(0)
  priceAmount Int
  isPopular   Boolean           @default(false)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  features    CoinPlanFeature[]
  purchases   CoinPurchase[]
}

model CoinPlanFeature {
  id        String   @id @default(cuid())
  planId    String
  plan      CoinPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String
  order     Int

  @@unique([planId, order])
}

model CoinPurchase {
  id                  String             @id @default(cuid())
  userId              String
  planId              String
  planName            String
  planSlug            String
  amount              Int
  coins               Int
  bonusCoins          Int                @default(0)
  totalCoins          Int
  status              PurchaseStatus     @default(PENDING)
  paymongoCheckoutId  String?            @unique
  paymongoPaymentId   String?            @unique
  referenceNumber     String             @unique
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  transactions        CoinTransaction[]
  plan                CoinPlan           @relation(fields: [planId], references: [id])
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
}

model CoinTransaction {
  id           String              @id @default(cuid())
  userId       String
  purchaseId   String?
  type         CoinTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime            @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase     CoinPurchase?       @relation(fields: [purchaseId], references: [id])

  @@index([userId, createdAt])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum CoinTransactionType {
  CREDIT
  DEBIT
}

model GameHistory {
  id             String   @id @default(cuid())
  userId         String
  gameType       String   @default("QUIZ")
  totalQuestions Int
  correctAnswers Int
  rewardCoins    Int      @default(0)
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([gameType])
}