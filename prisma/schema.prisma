generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  clerkId       String            @unique
  fullname      String
  image         String?
  coins         Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relations
  profiles      Profile[]
  comics        Comic[]
  purchases     CoinPurchase[]
  transactions  CoinTransaction[]
  comicUnlocks  ComicUnlock[]
  comments      Comment[] 
  likes         Like[]

  notifications         Notification[] @relation("userNotifications") // notifications received by a user
  notificationsCreated  Notification[] @relation("notificationCreator") // notifications triggered or created by a user
}

model Notification {
  id              String @id @default(cuid())
  userId          String
  creatorId       String
  type            NotificationType
  read            Boolean @default(false)
  comicId         String?
  createdAt       DateTime @default(now())

  // Relations
  user            User @relation("userNotifications", fields: [userId], references: [id], onDelete: Cascade)
  creator         User @relation("notificationCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  comic           Comic? @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

enum NotificationType {
  COMIC
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  image     String
  userId    String
  user      User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Comic {
  id                String         @id @default(cuid())
  title             String
  description       String
  thumbnail         String?
  thumbnailPublicId String?
  cloudinaryFolder  String?
  userId            String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relations
  user              User           @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  episodes          Episode[]
  unlocks           ComicUnlock[]
  notifications     Notification[]
}


model ComicUnlock {
  id         String   @id @default(cuid())
  userId     String
  comicId    String
  paidCoins  Int?
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  comic      Comic    @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@unique([userId, comicId])
  @@index([userId])
  @@index([comicId])
}

model Episode {
  id          String         @id @default(cuid())
  title       String
  description String
  comicId     String
  order       Int
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  // Relation
  comments    Comment[]
  images      EpisodeImage[]
  comic       Comic          @relation(fields: [comicId], references: [id], onDelete: Cascade)
  like        Like[]

  @@index([comicId])
  @@unique([comicId, order])
}

model Like {
  id          String @id @default(cuid())
  episodeId   String
  userId      String
  createdAt   DateTime @default(now())

  // Relations
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode     Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([userId, episodeId]) // composite index for faster query
  @@unique([userId, episodeId]) // this prevent user from liking post twice
}

model Comment {
  id          String @id @default(cuid())
  content     String
  authorId    String
  episodeId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  author          User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  episode         Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([authorId, episodeId]) // composite index for faster queries
}

model EpisodeImage {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String?
  order     Int
  createdAt DateTime @default(now())

  @@index([episodeId])
  @@index([publicId])
  @@unique([episodeId, order])
}

model CoinPlan {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  coins       Int
  bonusCoins  Int               @default(0)
  priceAmount Int
  isPopular   Boolean           @default(false)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  features    CoinPlanFeature[]
  purchases   CoinPurchase[]
}

model CoinPlanFeature {
  id        String   @id @default(cuid())
  planId    String
  plan      CoinPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String
  order     Int

  @@unique([planId, order])
}

model CoinPurchase {
  id                   String         @id @default(cuid())
  userId               String

  planId               String

  planName             String
  planSlug             String

  amount               Int
  coins                Int
  bonusCoins           Int            @default(0)
  totalCoins           Int
  status               PurchaseStatus @default(PENDING)

  paymongoCheckoutId   String?        @unique
  paymongoPaymentId    String?        @unique
  referenceNumber      String         @unique

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Relation
  transactions         CoinTransaction[]
  plan                 CoinPlan       @relation(fields: [planId], references: [id])
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
}

model CoinTransaction {
  id           String              @id @default(cuid())
  userId       String
  purchaseId   String?
  type         CoinTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime            @default(now())
  
  // Relation
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchase     CoinPurchase?       @relation(fields: [purchaseId], references: [id])

  @@index([userId, createdAt])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum CoinTransactionType {
  CREDIT
  DEBIT
}