generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  clerkId       String            @unique
  fullname      String
  image         String?
  coins         Int               @default(0)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  profiles      Profile[]
  comics        Comic[]
  purchases     CoinPurchase[]
  transactions  CoinTransaction[]
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  image     String
  userId    String
  user      User     @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Comic {
  id                String    @id @default(cuid())
  title             String
  description       String
  thumbnail         String?
  thumbnailPublicId String?
  cloudinaryFolder  String?
  userId            String
  user              User      @relation(fields: [userId], references: [clerkId], onDelete: Cascade)
  episodes          Episode[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Episode {
  id          String         @id @default(cuid())
  title       String
  description String
  comicId     String
  comic       Comic          @relation(fields: [comicId], references: [id], onDelete: Cascade)
  order       Int
  images      EpisodeImage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([comicId])
  @@unique([comicId, order])
}

model EpisodeImage {
  id        String   @id @default(cuid())
  episodeId String
  episode   Episode  @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  imageUrl  String
  publicId  String?
  order     Int
  createdAt DateTime @default(now())

  @@index([episodeId])
  @@index([publicId])
  @@unique([episodeId, order])
}

model CoinPlan {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  coins       Int
  bonusCoins  Int               @default(0)
  priceAmount Int
  isPopular   Boolean           @default(false)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  features    CoinPlanFeature[]
  purchases   CoinPurchase[]
}

model CoinPlanFeature {
  id        String   @id @default(cuid())
  planId    String
  plan      CoinPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  label     String
  order     Int

  @@unique([planId, order])
}

model CoinPurchase {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  planId               String
  plan                 CoinPlan       @relation(fields: [planId], references: [id])

  planName             String
  planSlug             String

  amount               Int
  coins                Int
  bonusCoins           Int            @default(0)
  totalCoins           Int
  status               PurchaseStatus @default(PENDING)

  paymongoCheckoutId   String?        @unique
  paymongoPaymentId    String?        @unique
  referenceNumber      String         @unique

  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  transactions         CoinTransaction[]

  @@index([userId])
  @@index([planId])
}

model CoinTransaction {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purchaseId   String?
  purchase     CoinPurchase?       @relation(fields: [purchaseId], references: [id])
  type         CoinTransactionType
  amount       Int
  balanceAfter Int
  description  String?
  createdAt    DateTime            @default(now())

  @@index([userId, createdAt])
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum CoinTransactionType {
  CREDIT
  DEBIT
}